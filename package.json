{
  "name": "wcc-cricket",
  "version": "1.0.0",
  "description": "WCC Cricket - Live Cricket Streaming App",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "expo": "^51.0.0",
    "expo-camera": "^14.1.0",
    "expo-av": "^14.0.0",
    "react": "^18.3.0",
    "react-native": "^0.74.0",
    "react-native-agora": "^4.2.0",
    "react-native-gesture-handler": "^2.14.0",
    "react-native-reanimated": "^3.5.0",
    "react-native-screens": "^3.29.0",
    "expo-status-bar": "^1.12.0",
    "expo-router": "^3.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~18.2.0"
  },
  "expo": {
    "name": "WCC Cricket",
    "slug": "wcc-cricket",
    "version": "1.0.0",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTabletMode": true,
      "bundleIdentifier": "com.wcccricket.app"
    },
    "android": {
      "package": "com.wcccricket",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "READ_PHONE_STATE"
      ],
      "versionCode": 1
    }
  }
}
