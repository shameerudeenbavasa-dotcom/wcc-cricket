{
  "name": "wcc-cricket",
  "version": "1.0.0",
  "description": "WCC Cricket - Live Cricket Streaming App",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "expo": "^51.0.0",
    "expo-camera": "~15.0.16",
    "expo-av": "^14.0.0",
    "expo-constants": "~16.0.2",
    "expo-linking": "~6.3.1",
    "expo-router": "^3.5.0",
    "expo-status-bar": "^1.12.0",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-agora": "^4.2.0",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-reanimated": "~3.10.1",
    "react-native-screens": "3.31.1",
    "react-native-safe-area-context": "4.10.5"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~18.2.0"
  },
  "expo": {
    "name": "WCC Cricket",
    "slug": "wcc",
    "version": "1.0.0",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.wcccricket",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "READ_PHONE_STATE"
      ],
      "versionCode": 1
    }
  }
}
