{
  "expo": {
    "name": "WCC Cricket",
    "slug": "wcc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#080C08"
    },
    "ios": {
      "bundleIdentifier": "com.wcccricket.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "WCC needs camera access to stream the live match.",
        "NSMicrophoneUsageDescription": "WCC needs microphone access for commentary."
      }
    },
    "android": {
      "package": "com.wcccricket",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./icon.png",
        "backgroundColor": "#080C08"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow WCC to use the camera for live streaming.",
          "microphonePermission": "Allow WCC to use the microphone for commentary."
        }
      ],
      "expo-av"
    ]
  }
}
