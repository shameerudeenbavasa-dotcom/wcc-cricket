{
  "expo": {
    "name": "WCC Cricket",
    "slug": "wcc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.wcccricket.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "WCC needs camera access to stream the live match.",
        "NSMicrophoneUsageDescription": "WCC needs microphone for commentary."
      }
    },
    "android": {
      "package": "com.wcccricket",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.BLUETOOTH",
        "android.permission.ACCESS_WIFI_STATE"
      ]
    },
    "plugins": [
      [
        "react-native-agora",
        {
          "cameraPermission": "Allow WCC to use camera for live streaming.",
          "microphonePermission": "Allow WCC to use microphone for commentary."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "441796f3-adb4-4dea-b385-4513e72a8d60"
      }
    }
  }
}